---
import '../styles/global.css' 
import TableOfContents from '../components/TableOfContents.astro';
import Heading from '../components/Heading.astro';
export interface Props {
  content: {
    title: string;
  },
  headings: {
    slug: string;
    text: string;
    depth: number;
  }[]
}

const {
  content: { title },
  headings
} = Astro.props;
---

<main class="p-10 min-h-screen w-screen bg-[url(/bg.svg)] relative">
    <div class = "grid grid-cols-5 gap-10 min-h-screen">
        <div class = "hidden md:inline col-span-1">
        {headings && headings.length > 0 && (
            <nav class="fixed h-full flex flex-col">
              <img alt = "A bouncing pagedoll of Yippee Orpheus" class = "max-w-1/2" src = "https://hc-cdn.hel1.your-objectstorage.com/s/v3/4ec54533d119d90d8ac2e753284783c8aced4d28_image.png"/>
              <div class = "my-6">
                <p class = "font-bold !font-heading">Table of Contents</p>
                <TableOfContents headings={headings} />
              </div>
              <img class = "fixed -bottom-20 size-40 animate-bounce hover:animate-none hover:-bottom-5 hover:scale-110 transition-all duration-300" src = "https://cloud-n807bcpij-hack-club-bot.vercel.app/10318016-8380173-super-matte-5000-uncoated-vinyl-stickers_11.png"/>

            </nav>
          )}</div>
          
        <div class = "col-span-full md:col-span-4 lg:col-span-3 overflow-scroll">
            <Heading/>
            <div class = "py-8">
                <h2 class = "py-4">{title}</h2>
                <div class = "font-body">
                    <slot/>
                </div>
            </div>
        </div>

        <div class = "hidden lg:inline *:hidden *:lg:inline col-span-1 relative">
          <div class="fixed top-1/2 -translate-y-1/2 bg-white">
              <div class = "border !p-5 h-max flex flex-col justify-center items-center">
                <img 
                    src = "https://hc-cdn.hel1.your-objectstorage.com/s/v3/6b49266031347b5fe3531e378218497f1d367d8a_b7edc1ebc8c5c4ee111bc087627ac997aa733682_image.png"
                    class = "object-cover aspect-square w-36 border border-black"/>
                    <div class = "py-4 *:text-center">
                      <p class = "flex flex-row items-center gap-2">
                        orpheus' awesome blog
                        <a target="_blank" href = "https://github.com/hackclub/tribute">
                          <svg class = "size-6 inline hover:fill-emerald-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 496 512"><!--!Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path d="M165.9 397.4c0 2-2.3 3.6-5.2 3.6-3.3 .3-5.6-1.3-5.6-3.6 0-2 2.3-3.6 5.2-3.6 3-.3 5.6 1.3 5.6 3.6zm-31.1-4.5c-.7 2 1.3 4.3 4.3 4.9 2.6 1 5.6 0 6.2-2s-1.3-4.3-4.3-5.2c-2.6-.7-5.5 .3-6.2 2.3zm44.2-1.7c-2.9 .7-4.9 2.6-4.6 4.9 .3 2 2.9 3.3 5.9 2.6 2.9-.7 4.9-2.6 4.6-4.6-.3-1.9-3-3.2-5.9-2.9zM244.8 8C106.1 8 0 113.3 0 252c0 110.9 69.8 205.8 169.5 239.2 12.8 2.3 17.3-5.6 17.3-12.1 0-6.2-.3-40.4-.3-61.4 0 0-70 15-84.7-29.8 0 0-11.4-29.1-27.8-36.6 0 0-22.9-15.7 1.6-15.4 0 0 24.9 2 38.6 25.8 21.9 38.6 58.6 27.5 72.9 20.9 2.3-16 8.8-27.1 16-33.7-55.9-6.2-112.3-14.3-112.3-110.5 0-27.5 7.6-41.3 23.6-58.9-2.6-6.5-11.1-33.3 2.6-67.9 20.9-6.5 69 27 69 27 20-5.6 41.5-8.5 62.8-8.5s42.8 2.9 62.8 8.5c0 0 48.1-33.6 69-27 13.7 34.7 5.2 61.4 2.6 67.9 16 17.7 25.8 31.5 25.8 58.9 0 96.5-58.9 104.2-114.8 110.5 9.2 7.9 17 22.9 17 46.4 0 33.7-.3 75.4-.3 83.6 0 6.5 4.6 14.4 17.3 12.1C428.2 457.8 496 362.9 496 252 496 113.3 383.5 8 244.8 8zM97.2 352.9c-1.3 1-1 3.3 .7 5.2 1.6 1.6 3.9 2.3 5.2 1 1.3-1 1-3.3-.7-5.2-1.6-1.6-3.9-2.3-5.2-1zm-10.8-8.1c-.7 1.3 .3 2.9 2.3 3.9 1.6 1 3.6 .7 4.3-.7 .7-1.3-.3-2.9-2.3-3.9-2-.6-3.6-.3-4.3 .7zm32.4 35.6c-1.6 1.3-1 4.3 1.3 6.2 2.3 2.3 5.2 2.6 6.5 1 1.3-1.3 .7-4.3-1.3-6.2-2.2-2.3-5.2-2.6-6.5-1zm-11.4-14.7c-1.6 1-1.6 3.6 0 5.9 1.6 2.3 4.3 3.3 5.6 2.3 1.6-1.3 1.6-3.9 0-6.2-1.4-2.3-4-3.3-5.6-2z"/></svg>
                        </a>
                      </p> 
                      <p class = "italic">(this user follows you)</p>
                      <div class = "flex flex-row gap-4 justify-center">
                        <a href = "https://hackclub.com">follow</a>
                        <a href = "https://hackclub.com/slack">message</a>
                  </div>
              </div>
            </div>
          
          <div class = "border-x border-b p-5 w-full flex flex-col items-center">
            <audio controls class = "w-48 bg-white border border-black rounded-full">
              <source src = "https://hc-cdn.hel1.your-objectstorage.com/s/v3/181832e866502ffe2d6964fd39615596f590e6ee_youtube_ehh_52fzstw_1920x1080_h264__mp3cut.net__audio.mp4"/>
            </audio>
            <span class = "text-base">RAN AWAY ft. Heather</span>
            <span class = "uppercase text-xs font-sans">HACK CLUB</span>
          </div>
        </div>
        </div>
</main>